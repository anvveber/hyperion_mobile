<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/secondary">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="@color/secondary" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/primary" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
